public class CorrectiveActionPlan
{
    public Guid Id { get; set; }
    public Guid ComplianceReportId { get; set; } // Link to main report/visit
    public string PlanDetails { get; set; }      // Description
    public DateTime Deadline { get; set; }       // When evidence is due
    public string CreatedById { get; set; }
    public DateTime CreatedOn { get; set; }
    public CorrectiveActionPlanStatus Status { get; set; }
    public ICollection<CorrectiveEvidence> Evidences { get; set; }
}
public enum CorrectiveActionPlanStatus
{
    Draft, SentToLicensee, EvidenceSubmitted, UnderReview, Approved, Returned, Closed
}


/////// 
public class CorrectiveEvidence
{
    public Guid Id { get; set; }
    public Guid PlanId { get; set; }
    public string FileName { get; set; }
    public string FileUrl { get; set; }
    public string UploadedById { get; set; }
    public DateTime UploadedOn { get; set; }
    public string Comments { get; set; }
    public EvidenceStatus Status { get; set; }
}
public enum EvidenceStatus
{
    Pending, Accepted, Returned
}
