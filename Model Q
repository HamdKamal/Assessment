public interface ICorrectiveActionPlanService
{
    Task<Guid> CreatePlanAsync(CorrectiveActionPlanDto dto, string createdById);
    Task<Guid> UploadEvidenceAsync(Guid planId, EvidenceUploadDto dto, string userId);
    Task ReviewEvidenceAsync(Guid planId, EvidenceReviewDto dto, string reviewerId);
}

public interface IComplianceReportReviewService
{
    Task ReviewReportAsync(Guid reportId, ComplianceReportReviewDto dto, string reviewerRole, string reviewerId);
}


/////// service ////////////

public class CorrectiveActionPlanService : ICorrectiveActionPlanService
{
    private readonly ApplicationDbContext _db;
    private readonly IWebHostEnvironment _env;

    public CorrectiveActionPlanService(ApplicationDbContext db, IWebHostEnvironment env)
    {
        _db = db;
        _env = env;
    }

    public async Task<Guid> CreatePlanAsync(CorrectiveActionPlanDto dto, string createdById)
    {
        var plan = new CorrectiveActionPlan
        {
            Id = Guid.NewGuid(),
            ComplianceReportId = dto.ComplianceReportId,
            PlanDetails = dto.PlanDetails,
            Deadline = dto.Deadline,
            CreatedById = createdById,
            CreatedOn = DateTime.UtcNow,
            Status = CorrectiveActionPlanStatus.SentToLicensee
        };

        _db.CorrectiveActionPlans.Add(plan);
        await _db.SaveChangesAsync();

        // TODO: Notify entity

        return plan.Id;
    }

    public async Task<Guid> UploadEvidenceAsync(Guid planId, EvidenceUploadDto dto, string userId)
    {
        var plan = await _db.CorrectiveActionPlans.FindAsync(planId);
        if (plan == null) throw new Exception("Plan not found");

        var uploadsDir = Path.Combine(_env.WebRootPath, "uploads", "evidence", plan.Id.ToString());
        Directory.CreateDirectory(uploadsDir);

        var fileName = $"{Guid.NewGuid()}_{dto.File.FileName}";
        var filePath = Path.Combine(uploadsDir, fileName);

        using (var stream = new FileStream(filePath, FileMode.Create))
        {
            await dto.File.CopyToAsync(stream);
        }

        var evidence = new CorrectiveEvidence
        {
            Id = Guid.NewGuid(),
            PlanId = planId,
            FileName = fileName,
            FileUrl = $"/uploads/evidence/{plan.Id}/{fileName}",
            UploadedById = userId,
            UploadedOn = DateTime.UtcNow,
            Comments = dto.Comments,
            Status = EvidenceStatus.Pending
        };
        _db.CorrectiveEvidences.Add(evidence);
        await _db.SaveChangesAsync();

        // TODO: Notify Compliance Specialist

        return evidence.Id;
    }

    public async Task ReviewEvidenceAsync(Guid planId, EvidenceReviewDto dto, string reviewerId)
    {
        var evidence = await _db.CorrectiveEvidences.FindAsync(dto.EvidenceId);
        if (evidence == null) throw new Exception("Evidence not found");

        evidence.Status = dto.IsApproved ? EvidenceStatus.Accepted : EvidenceStatus.Returned;
        evidence.Comments += $"\nReview by {reviewerId}: {dto.ReviewerComments}";

        await _db.SaveChangesAsync();

        // TODO: Notify entity
    }
}

public class ComplianceReportReviewService : IComplianceReportReviewService
{
    private readonly ApplicationDbContext _db;
    public ComplianceReportReviewService(ApplicationDbContext db)
    {
        _db = db;
    }

    public async Task ReviewReportAsync(Guid reportId, ComplianceReportReviewDto dto, string reviewerRole, string reviewerId)
    {
        var review = new ComplianceReportReview
        {
            Id = Guid.NewGuid(),
            ComplianceReportId = reportId,
            ReviewerRole = reviewerRole,
            IsApproved = dto.IsApproved,
            ReasonForReturn = dto.ReasonForReturn,
            ReviewedOn = DateTime.UtcNow,
            ReviewedById = reviewerId
        };
        _db.ComplianceReportReviews.Add(review);
        await _db.SaveChangesAsync();

        // TODO: Notify next party
    }
}

