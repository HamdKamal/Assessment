[ApiController]
[Route("api/[controller]")]
public class CorrectivePlanController : ControllerBase
{
    private readonly ApplicationDbContext _db;
    private readonly IWebHostEnvironment _env;
    // Inject your notification/email service as needed

    public CorrectivePlanController(ApplicationDbContext db, IWebHostEnvironment env)
    {
        _db = db;
        _env = env;
    }

    // 1. Create and share corrective action plan
    [HttpPost]
    public async Task<IActionResult> CreatePlan([FromBody] CorrectiveActionPlanDto dto)
    {
        var plan = new CorrectiveActionPlan
        {
            Id = Guid.NewGuid(),
            ComplianceReportId = dto.ComplianceReportId,
            PlanDetails = dto.PlanDetails,
            Deadline = dto.Deadline,
            CreatedById = User.Identity.Name, // Or AD user id
            CreatedOn = DateTime.UtcNow,
            Status = CorrectiveActionPlanStatus.SentToLicensee
        };

        _db.CorrectiveActionPlans.Add(plan);
        await _db.SaveChangesAsync();

        // TODO: Notify Licensed Entity Representative here

        return Ok(new { message = "Corrective action plan created", planId = plan.Id });
    }

    // 2. Upload evidence (licensed entity)
    [HttpPost("{planId}/evidence")]
    public async Task<IActionResult> UploadEvidence([FromRoute] Guid planId, [FromForm] IFormFile file, [FromForm] string comments)
    {
        var plan = await _db.CorrectiveActionPlans.FindAsync(planId);
        if (plan == null) return NotFound("Plan not found");

        var uploadsDir = Path.Combine(_env.WebRootPath, "uploads", "evidence", plan.Id.ToString());
        Directory.CreateDirectory(uploadsDir);

        var fileName = $"{Guid.NewGuid()}_{file.FileName}";
        var filePath = Path.Combine(uploadsDir, fileName);

        using (var stream = new FileStream(filePath, FileMode.Create))
        {
            await file.CopyToAsync(stream);
        }

        var evidence = new CorrectiveEvidence
        {
            Id = Guid.NewGuid(),
            PlanId = planId,
            FileName = fileName,
            FileUrl = $"/uploads/evidence/{plan.Id}/{fileName}",
            UploadedById = User.Identity.Name,
            UploadedOn = DateTime.UtcNow,
            Comments = comments,
            Status = EvidenceStatus.Pending
        };
        _db.CorrectiveEvidences.Add(evidence);
        await _db.SaveChangesAsync();

        // TODO: Notify Compliance Specialist

        return Ok(new { message = "Evidence uploaded", evidenceId = evidence.Id });
    }

    // 3. Review evidence (Compliance Specialist)
    [HttpPost("{planId}/review-evidence")]
    public async Task<IActionResult> ReviewEvidence([FromRoute] Guid planId, [FromBody] EvidenceReviewDto dto)
    {
        var evidence = await _db.CorrectiveEvidences.FindAsync(dto.EvidenceId);
        if (evidence == null) return NotFound("Evidence not found");

        evidence.Status = dto.IsApproved ? EvidenceStatus.Accepted : EvidenceStatus.Returned;
        evidence.Comments += $"\nReview: {dto.ReviewerComments}"; // Append review comments

        await _db.SaveChangesAsync();

        // TODO: Notify Licensed Entity of acceptance or need for more info

        return Ok(new { message = "Evidence reviewed" });
    }

    // 4. Compliance Manager approves/returns report
    [HttpPost("/api/report/{reportId}/manager-review")]
    public async Task<IActionResult> ReviewReportByManager([FromRoute] Guid reportId, [FromBody] ComplianceReportReviewDto dto)
    {
        var review = new ComplianceReportReview
        {
            Id = Guid.NewGuid(),
            ComplianceReportId = reportId,
            ReviewerRole = "ComplianceManager",
            IsApproved = dto.IsApproved,
            ReasonForReturn = dto.ReasonForReturn,
            ReviewedOn = DateTime.UtcNow,
            ReviewedById = User.Identity.Name
        };
        _db.ComplianceReportReviews.Add(review);
        await _db.SaveChangesAsync();

        // TODO: Notify Director General or Compliance Specialist

        return Ok(new { message = "Report reviewed by manager" });
    }

    // 5. Director General final approval/return
    [HttpPost("/api/report/{reportId}/director-review")]
    public async Task<IActionResult> ReviewReportByDirector([FromRoute] Guid reportId, [FromBody] ComplianceReportReviewDto dto)
    {
        var review = new ComplianceReportReview
        {
            Id = Guid.NewGuid(),
            ComplianceReportId = reportId,
            ReviewerRole = "DirectorGeneral",
            IsApproved = dto.IsApproved,
            ReasonForReturn = dto.ReasonForReturn,
            ReviewedOn = DateTime.UtcNow,
            ReviewedById = User.Identity.Name
        };
        _db.ComplianceReportReviews.Add(review);
        await _db.SaveChangesAsync();

        // TODO: Notify Compliance Manager

        return Ok(new { message = "Report reviewed by director" });
    }
}
