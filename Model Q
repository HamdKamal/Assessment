public class ComplianceRequestFilterDto
{
    public string Status { get; set; }
    public string VisitType { get; set; }
    public string LicenseeName { get; set; }
    public string SiteName { get; set; }
    public DateTime? VisitDate { get; set; } // single date, not a range
}

///// 

[HttpPost("filter")]
public async Task<ActionResult<List<ComplianceRequestDto>>> GetComplianceRequests([FromBody] ComplianceRequestFilterDto filter)
{
    var query = dbContext.ComplianceRequest
        .Include(r => r.Status)
        .Include(r => r.ComplianceDetails)
        .AsQueryable();

    // Status filter
    if (!string.IsNullOrEmpty(filter.Status))
        query = query.Where(r => r.Status.ValueEn == filter.Status || r.Status.ValueAr == filter.Status);

    // Visit type filter
    if (!string.IsNullOrEmpty(filter.VisitType))
        query = query.Where(r => r.ComplianceDetails.Any(d => d.VisitTypeName == filter.VisitType));

    // Licensee name filter
    if (!string.IsNullOrEmpty(filter.LicenseeName))
        query = query.Where(r => r.ComplianceDetails.Any(d => d.LicensedEntityName.Contains(filter.LicenseeName)));

    // Site name filter
    if (!string.IsNullOrEmpty(filter.SiteName))
        query = query.Where(r => r.ComplianceDetails.Any(d => d.LocationName.Contains(filter.SiteName)));

    // Visit date filter (exact match)
    if (filter.VisitDate.HasValue)
        query = query.Where(r => r.ComplianceDetails.Any(d => d.VisitDate.HasValue && d.VisitDate.Value.Date == filter.VisitDate.Value.Date));

    // Select data to DTO (can use AutoMapper in a real project)
    var list = await query
        .Select(r => new ComplianceRequestDto
        {
            Id = r.Id,
            Seq = r.Seq,
            CreatedOn = r.CreatedOn,
            StatusName = r.Status.ValueAr, // or .ValueEn
            VisitTypeName = r.ComplianceDetails.OrderByDescending(d => d.VisitDate).FirstOrDefault().VisitTypeName,
            LicenseeName = r.ComplianceDetails.OrderByDescending(d => d.VisitDate).FirstOrDefault().LicensedEntityName,
            LocationName = r.ComplianceDetails.OrderByDescending(d => d.VisitDate).FirstOrDefault().LocationName,
            VisitDate = r.ComplianceDetails.OrderByDescending(d => d.VisitDate).FirstOrDefault().VisitDate,
            VisitReferenceNumber = r.ComplianceDetails.OrderByDescending(d => d.VisitDate).FirstOrDefault().VisitReferenceNumber,
            // Add any other properties needed for the UI
        })
        .ToListAsync();

    return Ok(list);
}
